# Copy to .env and fill in values. Never commit .env (see .gitignore).

# --- Existing (minimal placeholders) ---
# ANTHROPIC_API_KEY=
# DATABASE_URL=postgresql://user:pass@localhost:5432/yourdb
# REDIS_URL=redis://localhost:6379/0

# --- Email Intake Channel (Gmail IMAP) ---
# Gmail account that receives job requests (e.g. CEOAGENT@gmail.com).
# App Password from Google Account → Security → 2-Step Verification → App passwords.
# Do not use your normal Gmail password; only App Password works with IMAP when 2FA is on.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Poll interval in seconds (default 60 if unset).
EMAIL_POLL_INTERVAL=60
