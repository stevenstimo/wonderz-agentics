{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Crew Intelligent Lesson",
  "type": "object",
  "required": [
    "id",
    "agent_id",
    "created_at",
    "context_type",
    "what_worked",
    "where_found",
    "confidence",
    "source"
  ],
  "properties": {
    "id": { "type": "string" },
    "agent_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "context_type": { "type": "string" },
    "task_signature": { "type": "string" },
    "what_worked": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "where_found": {
      "type": "object",
      "required": ["paths"],
      "properties": {
        "paths": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "files": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "line", "matched_text"],
        "properties": {
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "matched_text": { "type": "string" }
        }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "source": {
      "type": "string",
      "enum": ["task_success", "user_positive_feedback", "user_correction"]
    },
    "supersedes": { "type": "string" },
    "ttl_days": { "type": "integer", "minimum": 1 }
  }
}
